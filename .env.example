# ToolEasy Environment Variables
# Copy to .env.production (source builds) or pass as Docker --build-arg values.

# --- Site & routing (build-time) ---
# Canonical URL for sitemap/SEO (Docker default: http://localhost:8080)
SITE_URL=https://www.usetooleasy.com
# Serve under a subpath, e.g. /pdf-tools/ (leave empty for root)
BASE_URL=
# Hide marketing homepage; tools-only UI (Docker build arg)
SIMPLE_MODE=false
# Comma-separated tool IDs to hide, e.g. edit-pdf,sign-pdf
DISABLE_TOOLS=

# --- CORS proxy (digital signature certificate chains) ---
VITE_CORS_PROXY_URL=
VITE_CORS_PROXY_SECRET=

# --- WASM modules ---
# Pre-configured CDN defaults work out of the box.
# For air-gapped deployments, point to your internal server (e.g. /wasm/pymupdf/).
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@tooleasy/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@tooleasy/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/

# --- OCR assets (optional; self-hosted / air-gapped) ---
VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

# --- Localization & branding (build-time) ---
VITE_DEFAULT_LANGUAGE=
VITE_BRAND_NAME=ToolEasy
VITE_BRAND_LOGO=
VITE_FOOTER_TEXT=
